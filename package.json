{
  "name": "universa-core2",
  "version": "2.0.0-alpha.1",
  "description": "Official Universa JavaScript SDK for contracts and network operations",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mainnet.json": "./mainnet.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "mainnet.json",
    "README.md",
    "LICENSE*"
  ],
  "scripts": {
    "coverage": "nyc npm run test",
    "test": "mocha --timeout 150000 -r ts-node/register test/**/*.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsup && node scripts/finalize-build.mjs",
    "prepack": "npm run typecheck && npm run build"
  },
  "keywords": [
    "network",
    "contracts",
    "frontend",
    "client"
  ],
  "author": "Universa Blockchain Team",
  "license": "(BSD-3-Clause OR GPL-2.0)",
  "bugs": "https://github.com/sergeych/universa-core2/issues",
  "homepage": "https://github.com/sergeych/universa-core2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergeych/universa-core2.git"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@types/big.js": "6.0.1",
    "big.js": "6.0.1",
    "unicrypto": "npm:unicrypto2@2.0.0-alpha.1"
  },
  "devDependencies": {
    "@types/chai": "^4.2.10",
    "@types/mocha": "^7.0.2",
    "@types/node": "^20.17.0",
    "chai": "^4.2.0",
    "file-loader": "^6.0.0",
    "mocha": "^8.0.1",
    "nyc": "^14.1.1",
    "ts-node": "^8.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "directories": {
    "test": "test"
  }
}
